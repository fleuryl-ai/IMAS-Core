+// ##############################################################################
+// # PROBE -- read-attribution instrumentation kept from the get() study         #
+// # (to_improve.md points 30/31: a whole-IDS get() on an append-built file asks  #
+// # for ~2 passes over the raw block, the extra one covering the per-step        #
+// # scalars). Enabled only with PANZER_READ_PROBE=1; PANZER_READ_PROBE_LOG=<n>   #
+// # additionally dumps the first n union calls so the walk order is visible.     #
+// # Stays out of any commit: delete this block when the v5 scalar-block work     #
+// # lands.                                                                       #
+// ##############################################################################
+namespace {
+struct ReadProbe {
+    struct Dset {
+        hsize_t chunk = 0;                     // chunk length in elements (from the file)
+        unsigned long long calls = 0;          // union calls touching this block
+        unsigned long long span_elems = 0;     // elements actually asked of HDF5 ([lo,hi) per call)
+        unsigned long long wanted_elems = 0;   // elements the caller actually wants
+        std::map<unsigned long long, unsigned> chunk_hits;  // chunk id -> times touched
+    };
+    struct PathStat {
+        unsigned long long calls = 0, leaves = 0, elems = 0;
+        unsigned long long lo = ~0ULL, hi = 0;
+    };
+    std::map<std::string, Dset> dsets;
+    std::map<std::string, PathStat> paths;
+    std::map<unsigned long long, unsigned long long> hist;  // leaves in the bucket -> visits
+    // Visits whose span is huge (a scattered leaf list read as one contiguous
+    // sweep): what they cost in wall clock, separately from the walk.
+    double scattered_seconds = 0.0;
+    unsigned long long scattered_visits = 0, scattered_span = 0, scattered_wanted = 0;
+    unsigned long long calls = 0, visits = 0, logged = 0, log_limit = 0;
+    ReadProbe() {
+        if (const char* s = std::getenv("PANZER_READ_PROBE_LOG")) log_limit = std::strtoull(s, nullptr, 10);
+    }
+    ~ReadProbe() {
+        if (!std::getenv("PANZER_READ_PROBE")) return;
+        std::cerr << "[PROBE] union calls=" << calls << " block visits=" << visits << std::endl;
+        std::cerr << std::setprecision(3)
+                  << "[PROBE-SCATTER] visits=" << scattered_visits
+                  << " span_elems=" << scattered_span << " wanted_elems=" << scattered_wanted
+                  << " seconds=" << scattered_seconds << std::endl;
+        for (auto& kv : hist)
+            std::cerr << "[PROBE-HIST] leaves_per_visit=" << kv.first << " visits=" << kv.second << std::endl;
+        for (auto& kv : paths)
+            std::cerr << "[PROBE-PATH] " << kv.first << " calls=" << kv.second.calls
+                      << " leaves=" << kv.second.leaves << " elems=" << kv.second.elems
+                      << " lo=" << kv.second.lo << " hi=" << kv.second.hi << std::endl;
+        for (auto& kv : dsets) {
+            const Dset& d = kv.second;
+            unsigned long long touches = 0;
+            for (auto& c : d.chunk_hits) touches += c.second;
+            const unsigned long long distinct = d.chunk_hits.size();
+            std::cerr << "[PROBE-DSET] " << kv.first << " chunk_elems=" << d.chunk
+                      << " calls=" << d.calls << " span_elems=" << d.span_elems
+                      << " wanted_elems=" << d.wanted_elems
+                      << " chunks_distinct=" << distinct << " chunks_touched=" << touches
+                      << " reread_x=" << (distinct ? double(touches) / double(distinct) : 0.0)
+                      << std::endl;
+        }
+    }
+};
+ReadProbe& readProbe() { static ReadProbe p; return p; }
+bool readProbeOn() { static const bool on = std::getenv("PANZER_READ_PROBE") != nullptr; return on; }
+}  // namespace
 
